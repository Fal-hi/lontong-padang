# Supabase Configuration
# Masukkan Project URL dan anon key dari Dashboard Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mode Pengembangan (Hanya aktif di development saat URL Supabase belum diisi)
# VITE_USE_MOCK=true
